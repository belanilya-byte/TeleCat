# ============================================================
# SECRETS / ENVIRONMENT
# ============================================================

.env
.env.*
!.env.example

secrets/
credentials/

*.pem
*.key
*.p12
*.pfx

# ============================================================
# DATABASES / DATABASE DUMPS
# ============================================================

# SQLite databases and runtime files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Database dumps / backups
*.dump
*.backup
*.bak

backups/
exports/

# IMPORTANT:
# Do NOT ignore *.sql globally.
# SQL migrations and schema files belong in Git.
# Production database dumps do NOT.

# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

