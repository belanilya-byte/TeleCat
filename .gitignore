# ============================================================
# BLOCKCHAIN DEVELOPMENT
# ============================================================

# Hardhat generated files
artifacts/
cache/

# Foundry generated files
out/
broadcast/

# Local blockchain state
.chain-data/

# Wallet / account secrets
keystore/

# IMPORTANT:
# Smart contracts, ABIs intended for the app, deployment addresses,
# migrations and other public blockchain data MAY belong in Git.
# Private keys, seed phrases and wallet credentials NEVER do.